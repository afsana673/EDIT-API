# Required: secret used by clients of YOUR proxy. Do not commit it.
PROXY_API_KEY=replace-with-a-very-long-random-secret

# Optional: use the official authorization for YOUR OWN ImgUpscaler account.
# Include the scheme (such as "Bearer ...") if the provider requires one.
IMGUPSCALER_AUTHORIZATION=
IMGUPSCALER_COOKIE=

# Optional: permit exactly one trusted browser origin. Leave empty for server-to-server use.
ALLOWED_ORIGIN=
